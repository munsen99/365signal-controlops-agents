#!/usr/bin/env bash
# Package-local entry. Canonical operator CLI is repo scripts/economic.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"
if [[ -f "${ROOT}/scripts/economic" ]]; then
  exec bash "${ROOT}/scripts/economic" "$@"
fi
echo "scripts/economic not found at repo root" >&2
exit 2
