# Phase B only. The mint is a dedicated six-decimal development SPL token,
# not real USDC. Never put signer private bytes in this file.
AEA_WALLET_PHASE=B
AEA_SOLANA_NETWORK=devnet
AEA_SOLANA_RPC_URL=https://api.devnet.solana.com
AEA_SOLANA_PUBLIC_WALLET=REPLACE_PUBLIC_ADDRESS
AEA_SOLANA_TOKEN_MINT=REPLACE_DEVELOPMENT_TOKEN_MINT
AEA_SOLANA_TOKEN_DECIMALS=6
AEA_SOLANA_SOURCE_TOKEN_ACCOUNT=REPLACE_SOURCE_ATA
AEA_SOLANA_DESTINATION_ID=devnet:test:recipient
AEA_SOLANA_DESTINATION_OWNER=REPLACE_APPROVED_DESTINATION_OWNER
AEA_SOLANA_COMMITMENT=confirmed
AEA_SOLANA_CONFIRMATION_TIMEOUT=90
AEA_SOLANA_RPC_TIMEOUT=20
# Exact canonical hash of the operator-installed Phase-B policy.
AEA_POLICY_HASH=REPLACE_POLICY_HASH
