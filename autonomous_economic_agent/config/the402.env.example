# the402 provider adapter. Default disabled. Secrets stay in files, not Git.
AEA_ENABLED_ADAPTERS=mock
AEA_THE402_ENABLED=0
AEA_THE402_LIVE_HTTP=0
AEA_THE402_PAYOUT_WALLET=0x7fc8ACC21e601c488e6EE4eE39AD67d3ecA12a7e
AEA_THE402_SERVICE_ID=
AEA_THE402_PARTICIPANT_ID=
# Opaque public reference: the402/provider/default
# Raw AEA_THE402_API_KEY / AEA_THE402_WEBHOOK_SECRET env values are forbidden.
# Operator installs each regular, non-symlink file as mode 0600, owned by this UID.
AEA_THE402_SECRET_UID=1000
# AEA_THE402_API_KEY_FILE=/home/proteu5/.config/controlops/economic/tokens/the402_api_key
# AEA_THE402_WEBHOOK_SECRET_FILE=/home/proteu5/.config/controlops/economic/tokens/the402_webhook_secret
